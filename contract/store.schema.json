{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ping.dev/contract/store.schema.json",
  "title": "Ping core RPC — collection store",
  "$defs": {
    "node": {
      "type": "object",
      "description": "One entry in the sidebar tree. Paths are relative to the workspace root and use forward slashes on every platform.",
      "required": ["name", "path", "type"],
      "properties": {
        "name": { "type": "string" },
        "path": { "type": "string" },
        "type": { "enum": ["collection", "folder", "request"] },
        "method": {
          "type": ["string", "null"],
          "description": "Request method for display; null for collections and folders, and for a file that could not be parsed."
        },
        "children": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        }
      },
      "additionalProperties": false
    },

    "storedRequest": {
      "type": "object",
      "description": "A request as it lives in a collection file. Field names mirror the http.send params; `name` is the sidebar label.",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "method": { "type": "string" },
        "url": { "type": "string" },
        "query": {
          "type": "array",
          "items": { "$ref": "https://ping.dev/contract/http.schema.json#/$defs/param" }
        },
        "headers": {
          "type": "array",
          "items": { "$ref": "https://ping.dev/contract/http.schema.json#/$defs/param" }
        },
        "body": { "$ref": "https://ping.dev/contract/http.schema.json#/$defs/body" },
        "auth": { "$ref": "https://ping.dev/contract/http.schema.json#/$defs/auth" },
        "timeoutMs": { "type": "integer" },
        "redirects": { "enum": ["never", "normal", "always"] },
        "verifyTls": { "type": "boolean" },
        "cookies": { "type": "boolean", "description": "False opts the request out of the cookie jar. Absent means on." },
        "httpVersion": { "enum": ["1.1", "2"], "description": "Pins the protocol version; 2 means prefer HTTP/2. Absent lets the client choose." },
        "maxBodyBytes": { "type": "integer" },
        "asserts": {
          "type": "array",
          "items": { "$ref": "https://ping.dev/contract/http.schema.json#/$defs/assert" }
        },
        "capture": {
          "type": "array",
          "items": { "$ref": "https://ping.dev/contract/http.schema.json#/$defs/capture" }
        },
        "docs": {
          "type": "string",
          "description": "Free-form markdown notes about the request. Nothing on the wire depends on it; importers use it for what a request cannot express, such as a script that was not carried over."
        }
      },
      "additionalProperties": false
    },

    "store.scan.params": {
      "type": "object",
      "required": ["root"],
      "properties": {
        "root": {
          "type": "string",
          "description": "Absolute workspace root. The shell owns it and supplies it on every call."
        }
      },
      "additionalProperties": false
    },
    "store.scan.result": {
      "type": "object",
      "required": ["collections"],
      "properties": {
        "collections": {
          "type": "array",
          "description": "Top-level folders, each a collection. Loose YAML at the root is not a collection.",
          "items": { "$ref": "#/$defs/node" }
        }
      },
      "additionalProperties": false
    },

    "store.read.params": {
      "type": "object",
      "required": ["root", "path"],
      "properties": {
        "root": { "type": "string" },
        "path": { "type": "string", "description": "Relative to root; must not escape it." }
      },
      "additionalProperties": false
    },
    "store.read.result": { "$ref": "#/$defs/storedRequest" },

    "store.write.params": {
      "type": "object",
      "required": ["root", "path", "request"],
      "properties": {
        "root": { "type": "string" },
        "path": { "type": "string" },
        "request": { "$ref": "#/$defs/storedRequest" }
      },
      "additionalProperties": false
    },
    "store.write.result": {
      "type": "object",
      "required": ["path"],
      "properties": { "path": { "type": "string" } },
      "additionalProperties": false
    },

    "store.create.params": {
      "type": "object",
      "required": ["root", "name"],
      "properties": {
        "root": { "type": "string" },
        "collection": {
          "type": "string",
          "description": "Relative path of an existing folder to create it in. Omitted means the workspace root."
        },
        "type": {
          "enum": ["request", "folder"],
          "default": "request",
          "description": "A folder is sanitised for every platform and made unique among its siblings (Name, Name 2)."
        },
        "name": { "type": "string" }
      },
      "additionalProperties": false
    },
    "store.create.result": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "description": "Where the new request was written; unique even for repeated names." }
      },
      "additionalProperties": false
    },

    "store.rename.params": {
      "type": "object",
      "required": ["root", "path", "name"],
      "properties": {
        "root": { "type": "string" },
        "path": { "type": "string", "description": "A request file or a folder, relative to the root." },
        "name": {
          "type": "string",
          "description": "A request's display name (its file follows unless it already carries that name's slug), or a folder's new name, sanitised. An existing folder of that name is an error."
        }
      },
      "additionalProperties": false
    },
    "store.move.params": {
      "type": "object",
      "required": ["root", "path", "to"],
      "properties": {
        "root": { "type": "string" },
        "path": { "type": "string", "description": "A request file or a folder. A collection cannot be moved." },
        "to": {
          "type": "string",
          "description": "An existing folder or collection, relative to the root. The workspace root, the folder itself, its descendants and any environments folder are refused."
        }
      },
      "additionalProperties": false
    },
    "store.duplicate.params": {
      "type": "object",
      "required": ["root", "path"],
      "properties": {
        "root": { "type": "string" },
        "path": { "type": "string", "description": "A request file, folder or collection. Copied next to the original as \"<name> copy\"; symlinks are skipped." }
      },
      "additionalProperties": false
    },
    "store.reorder.params": {
      "type": "object",
      "required": ["root", "path", "names"],
      "properties": {
        "root": { "type": "string" },
        "path": { "type": "string", "description": "A collection or folder, relative to the root." },
        "names": {
          "type": "array",
          "items": { "type": "string" },
          "description": "File names of entries directly inside it, in the order the sidebar and the runner should use. Written to the folder's hidden .order.yaml; anything left out follows alphabetically, folders stay ahead of requests, and an empty list removes the file. Rename, move, duplicate and delete keep it in step."
        }
      },
      "additionalProperties": false
    },
    "store.reorder.result": { "type": "object", "additionalProperties": false },
    "store.rename.result": { "$ref": "#/$defs/store.pathResult" },
    "store.move.result": { "$ref": "#/$defs/store.pathResult" },
    "store.duplicate.result": { "$ref": "#/$defs/store.pathResult" },
    "store.pathResult": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "description": "The new relative path. The same path when nothing needed to change." }
      },
      "additionalProperties": false
    },

    "store.scaffold.params": {
      "type": "object",
      "required": ["root"],
      "properties": {
        "root": { "type": "string" },
        "collection": {
          "type": "string",
          "default": "My Collection",
          "description": "Folder name of the starter collection."
        }
      },
      "additionalProperties": false
    },
    "store.scaffold.result": {
      "type": "object",
      "required": ["collection"],
      "properties": {
        "collection": {
          "type": "string",
          "description": "The starter collection's path relative to the workspace root."
        }
      },
      "additionalProperties": false
    },

    "store.delete.params": {
      "type": "object",
      "required": ["root", "path"],
      "properties": {
        "root": { "type": "string" },
        "path": {
          "type": "string",
          "description": "Relative path of a request, or of a collection or folder, which is removed recursively. The workspace root cannot be deleted."
        }
      },
      "additionalProperties": false
    },
    "store.delete.result": { "type": "object", "additionalProperties": false }
  }
}
