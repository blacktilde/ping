{
  "name": "ping-desktop",
  "version": "0.0.6",
  "description": "Ping desktop shell: Electron main process and Svelte UI.",
  "author": "Ping contributors",
  "desktopName": "ping",
  "homepage": "https://github.com/dbohry/ping",
  "repository": {
    "type": "git",
    "url": "https://github.com/dbohry/ping.git"
  },
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "smoke": "node test/smoke.mjs",
    "screenshots": "node test/screenshots.mjs",
    "package": "electron-builder",
    "package:dir": "electron-builder --dir"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.2",
    "codemirror": "^6.0.2",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "markdown-it": "^14.3.2"
  }
}
